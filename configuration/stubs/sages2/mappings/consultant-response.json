{
  "request": {
    "method": "GET",
    "urlPathPattern": "/consultants/([0-9A-Za-z_-]+)"
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "transformers": ["response-template"],
    "body": "{ \"externalId\": \"{{request.path.[1]}}\", \"nom\": \"DUPONT\", \"prenom\": \"Alice\" }"
  }
}